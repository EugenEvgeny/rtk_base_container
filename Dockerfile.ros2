# Optional ROS 2 sidecar. Does not open /dev/gnss or modify the receiver.
# Uses the official multi-architecture ROS image (x86_64 and arm64).
ARG ROS_DISTRO=jazzy
FROM ros:${ROS_DISTRO}-ros-base
ARG ROS_DISTRO
RUN apt-get update && apt-get install -y --no-install-recommends \
    "ros-${ROS_DISTRO}-rtcm-msgs" \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY gnss_base.py ros2_rtcm_bridge.py /app/
CMD ["python3", "/app/ros2_rtcm_bridge.py"]
