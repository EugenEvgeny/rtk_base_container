# On Linux: ls -l /dev/serial/by-id/
GNSS_HOST_DEVICE=/dev/serial/by-id/usb-u-blox_AG_-_www.u-blox.com_u-blox_GNSS_receiver-if00
# On Linux: stat -Lc '%g' /dev/ttyACM0 (adapt to actual device)
GNSS_DEVICE_GID=20
GNSS_BAUD=38400
TCP_BIND_IP=127.0.0.1
# Optional NTRIP v1 SOURCE publishing to an existing caster.
# Leave these unset for local TCP streaming only.
NTRIP_HOST=
NTRIP_PORT=2101
NTRIP_MOUNT=
NTRIP_PASSWORD=
NTRIP_TLS=false
